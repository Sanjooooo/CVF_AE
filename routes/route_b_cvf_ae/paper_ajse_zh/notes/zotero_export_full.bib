	volume = {183},
	issn = {09265805},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0926580526000282},
	doi = {10.1016/j.autcon.2026.106787},
	abstract = {Amid rapid global urbanization, cities have shifted into a predominantly building maintenance-oriented phase. Therefore, given that existing studies focus on inspecting simple standalone buildings with single UAV, this paper proposes an automatic path planning method for the refined inspection of complex, irregular building clusters. First, an adaptive layering mechanism is introduced to generate full coverage inspection points based on the structural characteristics of the 3D building cluster model. Initial obstacle free flight paths are then derived by integrating A* and greedy algorithms. Further path optimization is conducted by applying the 2-opt algorithm to eliminate intersections and reduce flight distance, while the DP (Douglas Peucke) algorithm is employed simplified the trajectory by reducing redundant waypoints. Experimental validation on six irregularly shaped buildings demonstrates a 9.6\% reduction in flight path length and a 47.7\% decrease in intermediate waypoints. The proposed framework enables refined inspection path planning for building clusters, improving the automation level and practical applicability of multi-UAVs based building operation and maintenance.},
	language = {en},
	urldate = {2026-05-14},
	journal = {Automation in Construction},
	author = {Chen, Penglu and Tan, Yi and Yi, Wen},
	month = mar,
	year = {2026},
	note = {titleTranslation: 复杂和不规则建筑群的多无人机精细检验路径的自适应规划},
	keywords = {/未读, /unread},
	pages = {106787},
	file = {PDF:D\:\\Zotero\\paper\\storage\\NMK5K24E\\Chen 等 - 2026 - Adaptive planning of multi-UAV refined inspection path for complex and irregular building clusters.pdf:application/pdf},
}

@article{dong_four-dimensional_2026,
	title = {A four-dimensional path planning approach for multi-{UAV} cooperative operations in complex urban environments},
	volume = {59},
	issn = {22142096},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S221420962600032X},
	doi = {10.1016/j.vehcom.2026.101030},
	abstract = {Unmanned aerial vehicles (UAVs) have shown great potential in urban applications. However, achieving multiUAV path planning in complex urban environments remains a signiﬁcant challenge. Existing studies are mostly conducted in two-dimensional or virtual three-dimensional settings and often consider only a single constraint factor, such as risk, wind ﬁeld, or timeliness, which limits the practical applicability of the planning results. To address this issue, this paper proposes a four-dimensional (4D) path planning method for multiple UAVs that integrates risk assessment and layered wind-ﬁeld modeling. First, a three-dimensional (3D) risk map is constructed based on real geographic information system (GIS) data, in which human and property risks are quantiﬁed into a uniﬁed cost function. Second, layered wind ﬁelds and mission time constraints are introduced to extend the decision-making space into four dimensions, while a multi-sampling-based normalization strategy for path length is proposed to achieve a uniﬁed quantiﬁcation of path risks and wind-ﬁeld constraints. Finally, an adaptive hybrid metaheuristic population (AHMP) optimization algorithm is designed to solve the resulting multi-UAV path planning problem in complex urban scenarios. Simulation results show that, in Scenario 1 (riskonly) and Scenario 2 (coupled risk–wind constraints), AHMP achieves consistently better performance across multiple evaluation metrics, in terms of path length, accumulated risk, wind cost, and runtime. In particular, under a high-density 12-UAV setting, AHMP reduces path length by 11.79–20.04\%, accumulated risk cost by 4.88–18.90\%, wind cost by 23.21–32.49\%, and running time by 28.78–55.02\% compared with particle swarm optimization (PSO), improved particle swarm optimization (IPSO), artiﬁcial bee colony (ABC), and PSO with simulated annealing (PSO+SA), while consistently generating collision-free feasible 3D trajectories. Moreover, in Scenario 3 (coupled risk–wind with time constraints), the proposed method further supports synchronized arrival of multiple UAVs, demonstrating its task feasibility under complex coupled constraints.},
	language = {en},
	urldate = {2026-05-14},
	journal = {Vehicular Communications},
	author = {Dong, Hailong and Liu, Yang and Liu, Guangli and Li, Hao and Dong, Shuxiang},
	month = jun,
	year = {2026},
	note = {titleTranslation: 复杂城市环境中多无人机协作操作的四维路径规划方法},
	keywords = {/未读, /unread},
	pages = {101030},
	file = {PDF:D\:\\Zotero\\paper\\storage\\FQRINLV2\\Dong 等 - 2026 - A four-dimensional path planning approach for multi-UAV cooperative operations in complex urban envi.pdf:application/pdf},
}

