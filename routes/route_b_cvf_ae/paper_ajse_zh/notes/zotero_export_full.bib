	keywords = {/未读, 深度学习, 神经网络, 图像分割},
	file = {张华博 - 2018 - 基于深度学习的图像分割研究与应用.pdf:D\:\\Zotero\\paper\\storage\\B4XF2YYB\\张华博 - 2018 - 基于深度学习的图像分割研究与应用.pdf:application/pdf},
}

@phdthesis{_unet_nodate,
	address = {武汉},
	type = {硕士学位论文},
	title = {{基于Unet的结直肠肿瘤区域分割方法研究与实现}},
	url = {https://doi.org/10.27158/d.cnki.ghznu.2024.000365},
	doi = {10.27158/d.cnki.ghznu.2024.000365},
	abstract = {近年来,结直肠癌的发病率持续攀升,对其进行早期精准诊断和制定治疗计划尤为关键。虽然计算机断层扫描已成为结直肠癌诊断的重要工具,但传统的手工病灶区域勾画方式效率低且耗时长。为此,本研究旨在运用基于Unet的深度学习方法,实现对结直肠肿瘤区域的高效、准确的分割,为医生制定更为准确的治疗方案,提供更有效的辅助帮助。
在研究的初步阶段,本研究对影像数据集进行格式转换、裁剪、重采样、标准化和数据增广等一系列预处理操作。随后,考虑到结直肠肿瘤在影像中呈现的各种特征,从二维和三维两个方面分别构建了2D RA-Unet和3D ACE-Unet分割模型。在二维分割模型方面,本研究提出的2D RA-Unet在2D Unet的基础上添加了残差结构和注意力机制来聚焦关键分割区域,提升网络分割的准确度。在三维分割模型方面,本研究为充分利用结直肠数据切片序列之间的空间信息,首先提出了3D高分辨率Unet和3D低分辨率Unet两种基础分割模型。此外,为了更好地聚焦于关键区域、降低噪声和非关联信息的干扰,将注意力机制整合于上述模型之中。同时,通过3D低分辨率Unet与3D高分辨率Unet的级联结合,形成了3D Unet级联网络,以进一步优化分割性能。为了实现更好的分割效果,本研究还采用加权投票集成策略,整合2D Unet、3D低分辨率Unet、3D高分辨率Unet及3D Unet级联网络,最终构建出综合性能最为出色的3D ACE-Unet分割模型。
然而,成像过程中由于设备、成像参数等因素的不同造成影像特征差异较大,仅仅依赖固定网络模型可能存在一定的泛化性和适应性问题。因此,本研究进一步利用遗传算法和粒子群优化算法,基于2D Unet网络模型,自动搜索最优网络结构并自适应地选择超参数,从而增强模型的泛化能力,确保其在不同数据集上都能展现良好的性能。
本研究选用152名结直肠癌患者的CT影像数据作为训练集,17名患者的CT影像数据作为测试集。实验结果验证了2D RA-Unet和3D ACE-Unet分割模型的可行性和有效性。其中,2D RA-Unet的Dice值达到0.7810,ACC值达到0.9639,3D ACE-Unet的Dice值达到0.8560,ACC值达到0.9781。通过遗传算法和粒子群优化算法对2D Unet进行网络结构优化,模型的ACC值已超过0.9500,显示出较高的准确率。
综上所述,本研究在结直肠肿瘤自动分割领域展现了较好的临床实用价值,为结直肠癌的早期诊断与治疗提供了更为科学、精准的技术支持。},
	language = {zh},
	urldate = {2025-05-06},
	school = {华中农业大学},
	author = {{周旺}},
	collaborator = {{彭辉}},
	note = {major: 生物与医药硕士（专业学位）
download: 488
album: 医药卫生科技;信息科技
CLC: TP391.41;R735.34
dbcode: CMFD
dbname: CMFDTEMP
filename: 1024821237.nh},
	keywords = {/未读, 集成学习, 网络架构自动搜索, 医学影像分割, 注意力机制, Unet},
	file = {周旺 - 基于Unet的结直肠肿瘤区域分割方法研究与实现.pdf:D\:\\Zotero\\paper\\storage\\9WJCRFK9\\周旺 - 基于Unet的结直肠肿瘤区域分割方法研究与实现.pdf:application/pdf},
}

