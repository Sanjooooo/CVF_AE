@phdthesis{__2025-5,
	address = {哈尔滨},
	type = {硕士学位论文},
	title = {柔性航天器自适应姿态协同控制方法研究},
	url = {https://doi.org/10.27060/d.cnki.ghbcu.2022.002602},
	doi = {10.27060/d.cnki.ghbcu.2022.002602},
	abstract = {柔性航天器编队飞行技术在近年来广受关注。一方面,天线、太阳能帆板、太空机械臂等柔性附件有利于应对日益多样化和复杂化的空间任务;另一方面,航天器编队飞行不仅在灵活性和容错性上表现优越,而且具有低成本和易维护的显著优势。姿态协同控制作为航天器编队执行太空任务的前提和保障,仍然面临着诸多严峻的挑战,其中包括:未知的外界干扰、时变的惯性参数、难以测量的柔性模态、无法预料的执行机构故障,以及超远距离通信伴随的带宽受限等问题。本文基于滑模控制、自适应控制和有限时间控制方法,结合代数图论、神经网络、事件触发机制等相关工具,对各种条件下的柔性航天器姿态协同控制问题进行深入研究,主要内容如下:
(1)研究柔性航天器姿态协同控制系统的数学建模问题。为了达到简洁和非奇异的目的,基于单位四元数法对航天器刚性主体进行姿态描述,并结合柔性振动方程建立柔性航天器姿态运动学和动力学模型。随后基于代数图论进行航天器编队通信拓扑结构描述,进一步建立柔性航天器姿态协同控制系统模型。
(2)研究存在系统不确定性的柔性航天器姿态协同控制问题,并基于快速终端滑模技术和二阶一致性算法设计有限时间鲁棒协同控制器。其中,针对未知的柔性模态和外界干扰,采用自适应线性逼近的方法对相关的不确定动态进行精确估计和补偿。另一方面,考虑到燃料损耗和任务载荷增减等原因导致航天器的惯性参数始终处于微小的变化之中,利用径向基神经网络实现对未知动态的系统辨识和控制。同时,为了缓解神经网络为控制系统算力带来的沉重负担,采用最小学习参数算法有效降低自适应网络的计算量需求。
(3)研究存在执行机构故障的柔性航天器姿态协同控制问题,并基于自适应补偿算法设计有限时间容错控制器。由于柔性航天器编队通常面临着漫长的服役周期和复杂的太空环境,其姿态控制系统的执行机构不可避免会发生各种无法预料的故障。因此在解决系统不确定性的基础之上,考虑到执行机构潜在的部分失效故障和随机漂移故障,设计自适应容错算法,实现执行机构故障下的柔性航天器有限时间姿态协同控制。
(4)研究存在通信约束的柔性航天器姿态协同控制问题,并基于事件触发机制设计有限时间鲁棒协同控制器。由于空间任务中超远距离通信的必要需求和星载通信系统的实际配置之间存在客观矛盾,柔性航天器编队的星间通信通常受到严格的带宽约束。因此利用事件触发机制大幅降低编队航天器之间的通信频率,从而在保证控制精度的前提下有效节省通信带宽,显著提高协同控制算法的可靠性和实用性。
一方面,基于李雅普诺夫方法的稳定性分析证明了上述控制算法的有限时间稳定性能。另一方面,数字仿真实验的运行结果验证了本文控制策略的有效性和实用性,对比分析论证则充分展现了其优越性能。最后,对本文的主要研究成果进行了总结,并对未来的研究内容进行了展望。},
	language = {zh},
	urldate = {2025-10-24},
	school = {哈尔滨工程大学},
	author = {{贺玉山}},
	collaborator = {{郝勇} and {孟超}},
	year = {2025},
	note = {major: 控制工程（专业学位）
download: 107
album: 工程科技Ⅱ辑
CLC: V448.2
