	file = {PDF:D\:\\Zotero\\paper\\storage\\C22VJXSI\\Meng 等 - 2025 - Evolutionary state estimation-based multi-strategy jellyfish search algorithm for multi-UAV cooperat.pdf:application/pdf},
}

@article{li_facilitating_2025-1,
	title = {Facilitating multi-{UAVs} application for rescue in complex {3D} sea wind offshore environment: {A} scalable multi-{UAVs} collaborative path planning method based on improved coatis optimization algorithm},
	volume = {324},
	issn = {00298018},
