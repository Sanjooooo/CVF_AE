@phdthesis{__nodate,
	address = {长春},
	type = {硕士学位论文},
	title = {基于偏振的去雾和去耀斑图像处理算法研究},
	url = {https://doi.org/10.26977/d.cnki.gccgc.2024.000116},
	doi = {10.26977/d.cnki.gccgc.2024.000116},
	abstract = {随着计算机视觉和光学成像领域的不断发展,图像复原技术在改善视觉感知和图像质量方面取得了显著的进展。而雾霾和水面耀斑等大气和环境因素对图像质量产生了显著的负面影响。本学位论文聚焦于基于偏振成像的图像去雾和水面图像去耀斑技术,旨在通过深入研究偏振成像过程和图像恢复算法,改善图像的清晰度、对比度,并提高其在复杂环境下的适应性。完成的主要研究内容如下:
在图像去雾方面,为解决图像去雾后色彩偏移和去雾不完全的问题。本文改进并提出了结合偏振特性和深度学习的图像自监督学习去雾算法。首先,基于YOLY网络框架,在透射率特征估计网络中引入多尺度模块和注意力机制模块,提取不同尺度的特征信息,计算权重分配,估计更精确的透射率特征。其次,提出了基于YCb Cr颜色空间的亮度一致性损失和颜色一致性损失,约束去雾效果的亮度和色彩一致性,解决了去雾图像亮度偏暗和色彩偏移问题。最后,依据大气散射模型和损失函数约束训练网络对偏振图像进行去雾处理。在合成数据和真实数据上分别进行实验,并与7种算法进行效果对比。结果表明,相较于对比去雾算法,本文所提算法在合成图像样本中PSNR和SSIM能达到23.92和0.94,在真实图像样本中图像色彩恢复更真实,对比度更高,细节信息更加丰富,在主观和客观评价两方面均具有明显提升。验证了所提方法的有效性和优越性。
针对水面图像去耀斑的问题,本文研究了水面反射光的偏振特性,提出了一种结合偏振信息的水面图像去耀斑方法。通过分析偏振图像中的偏振信息和偏振分解的特性,利用水面耀斑和目标信息光的偏振特性差异构建水面反射耀斑分离模型,基于偏振最大/最小光强结合偏振分解实现水面去耀斑。实验结果表明,经过本文方法处理获得的耀斑抑制图像,区域对比度相比0°和90°偏振辐射图分别平均提升了70.47\%和40.55\%,图像信噪比相比0°和90°偏振辐射图分别平均提升了2.9倍和4.1倍。因此,所提方法对于提升水面图像质量和抑制耀斑效果具有显著优势。},
	language = {zh},
	urldate = {2025-05-01},
	school = {长春理工大学},
	author = {{索科}},
	collaborator = {{吕耀文}},
