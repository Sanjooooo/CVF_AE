	keywords = {/已读, 卷积神经网络, 目标分类, 偏振成像, 偏振特性因子, 三维卷积},
	file = {孙瑞 - 2021 - 基于卷积神经网络的偏振成像目标分类方法和实验研究.pdf:D\:\\Zotero\\paper\\storage\\LY3IUSIW\\孙瑞 - 2021 - 基于卷积神经网络的偏振成像目标分类方法和实验研究.pdf:application/pdf},
}

