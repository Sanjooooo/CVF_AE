Web of Science ID: WOS:001675266300001},
	keywords = {/unread, Engineering, Multidisciplinary, Path planning, Mathematics, Interdisciplinary Applications, Multi-UAV, Aerial surveillance, Agricultural monitoring, Mechanics, Mutation strategy, Optimization algorithms},
}

@article{wang_path-planning_2025,
