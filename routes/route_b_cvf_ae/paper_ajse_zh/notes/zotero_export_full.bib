	file = {张超 - 2020 - 基于预设性能方法的挠性航天器姿态控制研究.pdf:D\:\\Zotero\\paper\\storage\\THUNFKKK\\张超 - 2020 - 基于预设性能方法的挠性航天器姿态控制研究.pdf:application/pdf},
}

