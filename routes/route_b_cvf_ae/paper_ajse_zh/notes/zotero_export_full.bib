@phdthesis{__2025-6,
	address = {廊坊},
	type = {硕士学位论文},
	title = {基于语义分割的积水区域识别模型及应用研究},
	url = {https://doi.org/10.27899/d.cnki.gfzkj.2024.000003},
	doi = {10.27899/d.cnki.gfzkj.2024.000003},
	abstract = {近年来,城市因暴雨而造成的内涝灾害事件频发,已成为最严重的城市灾害之一。针对目前城市暴雨导致内涝过程中积水区域难以识别、实时监测精度不足等问题。基于深度学习的语义分割技术,对城市场景下的暴雨内涝过程中的积水区域进行提取,利用图像识别技术完成对积水区域与陆地区域的区分。首先对收集的大量城市积水图片进行标注,制作成积水图像学习样本数据集;其次利用SPD-Conv模块对Unet语义分割模型进行优化,提出了一种新的城市积水区域图像提取算法Spd-Unet模型。该模型使用含嵌入CBAM注意力机制的SPD-Conv模块改进编码器;通过在编码器和解码器连接处增加特征金字塔自注意力模块(FSA),很好地解决了由于水的形态不稳定而引起积水区域的尺度大小不一的问题;在解码器部分使用长跳跃连接,以整合更多的位置信息和语义信息,并应用SCSE注意力模块处理融合后的特征。实验结果表明,与目前常用的图像分割算法相比,Spd-Unet模型在积水图像提取方面效果更佳。
为解决采集的暴雨内涝图片中存在雨痕的问题,提高分割模型的效果,改进了一种基于Cycle GAN无监督去雨痕模型。在该模型的生成器部分使用CBAM注意力模块增强骨干网的提取能力,以辅助分类器区分有雨和无雨区域之间的差异性,使用自适应图层实例归一化(Ada LIN)对其风格和内容进行调整,在内容的细节处理部分使用改进的FSA特征金字塔自注意力模块进行优化。实验结果表明去雨后的图片分割效果比不去雨的分割效果要好。
综上,深度学习技术可以应用在城市内涝积水区域的提取和积水数据集去雨问题上,并且与传统监测方法相比,具有安全系数高、维护成本低、准确度高等优势。因此本研究可以为城市内涝积水过程的实时监测提供重要技术支撑和参考价值。
本文主要创新点如下:
(1)为解决城市内涝积水区域提取问题,本文以Unet为基本框架,结合CBAM注意力机制、SPD-Conv模块和特征金字塔自注意力(FSA)等模块,提出了针对城市积水场景下的分割模型Spd-Unet,提高了积水区域识别的精度。
(2)为解决采集的数据集中存在雨痕问题,本文改进了一种基于Cycle GAN无监督去雨模型,提高了预训练分割模型的效果。},
	language = {zh},
	urldate = {2025-04-14},
	school = {防灾科技学院},
	author = {{王志}},
	collaborator = {{李忠} and {黄建平}},
	year = {2025},
	note = {major: 资源与环境（专业学位）
download: 227
album: 工程科技Ⅱ辑;信息科技
