	year = {2020},
	keywords = {/未读},
	pages = {2149},
	file = {PDF:D\:\\Zotero\\paper\\storage\\EHMVNPZY\\Huang 等 - 2020 - A novel approach to measuring urban waterlogging depth from images based on mask region-based convol.pdf:application/pdf},
}

