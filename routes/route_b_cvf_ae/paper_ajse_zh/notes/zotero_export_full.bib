@article{wang_hcrs_2026-2,
	title = {{HCRS}: {Hierarchical} cooperative recombination strategy for many-objective multi-{UAV} path planning},
	volume = {217},
	issn = {09659978},
	shorttitle = {Hcrs},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0965997826000669},
	doi = {10.1016/j.advengsoft.2026.104160},
	abstract = {As the decision-making core of UAV to perform complex tasks, path planning aims to generate a safe, efficient and feasible flight path for the aircraft, which directly determines the success rate of the task and the energy efficiency ratio of the system. However, the multi-UAV path planning problem is a typical high-dimensional strong-coupled multi-objective optimization problem, and it is a great challenge to achieve both individual flight efficiency and group cooperative performance under complex space and time constraints. Therefore, this paper proposes a Hierarchical Cooperative Recombination Strategy (HCRS) for multi-UAV cooperative path optimization. The framework decomposes the global problem through a ‘‘two-level optimization’’ structure: in the lower level, each UAV performs multi-objective optimization independently to generate a candidate solution set, and then matches and fuses the candidate paths based on the collaborative recombination mechanism of non-dominated solutions, so as to construct a feasible and consistent multi-UAV path plan. In the upper layer, an evolutionary external archive mechanism is designed to maintain the diversity of nondominated solutions and establish an information feedback channel between the upper and lower layers, so that the algorithm can continue to expand the search space while maintaining convergence stability, and realize the organic unification of global and local optimization. In order to improve the search efficiency and adaptability of the system, HCRS introduces adaptive operator switching hybrid algorithm (AHS-GGWO), which realizes the adaptive adjustment of global exploration and local exploitation through the dynamic balance between grey Wolf optimization operator and genetic operator. Through the synergy of the above mechanisms, HCRS forms a dynamic evolution process of ‘‘individual optimization — global cooperation — information feedback’’, which effectively takes into account the quality of solution set and computational scalability. In the experimental verification of multi-UAV scenarios, HCRS shows higher optimization efficiency, convergence stability and robustness. The results show that the proposed HCRS framework can realize the efficient cooperation of multiple UAV systems in complex mission environments, and provides a scalable and practical optimization idea for the high-dimensional multi-objective path planning problem.},
