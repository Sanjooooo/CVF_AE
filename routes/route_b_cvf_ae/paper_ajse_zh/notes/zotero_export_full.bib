@article{li_tipfnet_2022,
	title = {{TIPFNet}: a transformer-based infrared polarization image fusion network},
	volume = {47},
	issn = {0146-9592, 1539-4794},
	shorttitle = {{TIPFNet}},
	url = {https://opg.optica.org/abstract.cfm?URI=ol-47-16-4255},
	doi = {10.1364/OL.466191},
	abstract = {The fusion of infrared intensity and polarization images can generate a single image with better visible perception and more vital information. Existing fusion methods based on a convolutional neural network (CNN), with local feature extraction, have the limitation of fully exploiting salient target features of polarization. In this Letter, we propose a transformer-based deep network to improve the performance of infrared polarization image fusion. Compared with existing CNN-based methods, our model can encode long-range features of infrared polarization images to obtain global contextual information using the self-attention mechanism. We also design a loss function with the self-supervised constraint to boost the performance of fusion. Experiments on the public infrared polarization dataset validate the effectiveness of the proposed method. Our approach achieves better fusion performance than the state-of-the-art.},
	language = {en},
	number = {16},
	urldate = {2025-04-09},
	journal = {Optics Letters},
	author = {Li, Kunyuan and Qi, Meibin and Zhuang, Shuo and Yang, Yanfang and Gao, Jun},
	month = aug,
	year = {2022},
	note = {titleTranslation: TIPFNet：一种基于 transformer 的红外偏振图像融合网络},
	keywords = {/已读},
	pages = {4255},
	file = {Li 等 - 2022 - TIPFNet a transformer-based infrared polarization image fusion network.pdf:D\:\\Zotero\\paper\\storage\\KXJ2CG2R\\Li 等 - 2022 - TIPFNet a transformer-based infrared polarization image fusion network.pdf:application/pdf},
}

@phdthesis{__2025-14,
	address = {广州},
	type = {硕士学位论文},
	title = {基于深度学习的城市道路积水信息识别方法研究},
	url = {https://doi.org/10.27151/d.cnki.ghnlu.2023.004803},
	doi = {10.27151/d.cnki.ghnlu.2023.004803},
	abstract = {随着全球气候变化和城镇化进程加快,城市区域极端降雨内涝事件频发,对居民生命财产安全和城市正常运行造成了严重影响。城市内涝监测可为城市内涝预警和防控提供数据支持,具有重要实际价值。然而,传统内涝监测方式存在较大局限,难以满足城市内涝高效全面监测的需要。研究如何通过深度学习技术利用城市道路监控摄像头快速准确地获取积水区域和深度等信息,对指导内涝预警和灾害防控具有重要实践意义。
本文利用深度学习获取城市道路积水信息,以网络共享的积水图像作为数据集,构建基于深度学习的城市内涝积水区域识别模型和积水深度计算模型,利用山东省东营市部分监控站点的积水监测资料对模型进行验证。论文主要研究成果如下:
(1)利用网络爬虫获取积水图像,通过数据增强和数据标注制作数据集,构建基于Mask RCNN的城市内涝积水区域识别模型。经过模型性能评估,定位精确度为83.33\%,掩膜分割精确度为78.59\%,表明Mask RCNN进行积水区域识别的精度较高,可用于积水区域的监测验证;同时,网络爬虫获取的积水图像能够满足Mask RCNN对积水特征学习的需要。
(2)基于车轮标识物的形状特征建立数据集,通过Mask RCNN进行训练,构建可用于车轮检测和分割的模型;利用AAMED椭圆检测算法对模型分割的淹没车轮图像进行特征参数提取,构建以车轮为标识物的城市道路积水深度计算模型。结果表明,模型对车轮的定位精确度达到94.96\%,掩膜分割精确度达到94.55\%,车轮能够准确地被模型分割,适宜作为构建积水深度计算模型的标识物,模型能够满足后续验证的要求。
(3)选择东营市典型监控站点积水信息作为验证资料,分别对所构建的内涝积水区域识别模型和深度计算模型进行验证与分析。结果表明:1)区域识别模型检测的积水区域与实际积水区域重叠度较高,识别效果较好,能够对积水范围进行较快速、准确的提取。2)深度计算模型对正侧面和斜侧面车辆均具有较好的识别效果,在内涝监测中具有较高的潜在应用价值。监测准确度受到监控角度和车辆距离的影响,正侧面车辆的识别结果优于斜侧面车辆,近点处的识别效果好于远点,图像分辨率对积水深度识别结果的影响明显。},
	language = {zh},
	urldate = {2025-04-13},
	school = {华南理工大学},
	author = {{廖宇鸿}},
	collaborator = {{黄国如} and {黄广灵}},
	year = {2025},
	note = {major: 土木水利（专业学位）
download: 239
album: 工程科技Ⅱ辑;信息科技
CLC: TU992;TP18;TP391.41
