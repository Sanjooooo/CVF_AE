@phdthesis{__2024-6,
	type = {硕士},
	title = {基于小样本学习的路面积水检测的研究},
	abstract = {随着自动驾驶等技术的不断发展,路面积水作为影响安全的因素,其准确感知也至关重要。传统的目标检测往往依赖于大量的标注数据,而路面积水并非是常态现象,获取大量标注数据既费时又费力,小样本学习能够在有限的标注数据下实现良好的检测效果,为路面积水检测的研究提供了新思路。本文基于深度学习理论和目标检测算法框架,对小样本学习和路面积水检测算法进行研究,针对迁移学习所造成的特征迁移问题和路面积水特征提取能力不佳等问题,通过改进注意力机制以及提出自适应元特征加权目标检测,提升模型的特征提取能力并补偿特征偏移,在不影响基类检测精度的前提下,提高新类的检测精度。本文研究内容主要有以下三个方面: (1)本文提出基于深层全局特征加权的自适应元特征加权模型(AMFWYOLO)。针对负样本干扰问题,在重加权模型中引入基于sc SE网络的注意力机制,使得模型关注图像的细粒度特征,进而提高模型的特征提取能力。其次设计了AMFW模块,对大样本图像进行二次加权,减少模型造成的元特征的权重偏移。实验表明,AMFW-YOLO相较于FRSW模型和SE-SMFR模型中Novel Set 1的不同shot任务mAP整体分别提升了4.28\%和2.36\%。 (2)本文提出基于多尺度蒸馏的小样本目标检测模型(MSDM)。针对Faster R-CNN因优化目标不同且存在类间差异会产生冲突及标注数据过少会导致模型只能提取样本图像的单一特征等问题,引入多尺度注意力机制用于提取图像的多粒度特征,同时设计了注意力蒸馏模块,采用健-值映射提取新类与基类的关联信息及稀疏Pairwise损失函数进行密集采样,有效抑制负样本信息的干扰能力,动态适应不同类别,进而提升模型的泛化能力。实验表明,2-shot任务中表现较为突出,相较于LSTD,模型性能提升了11.6\%,与FRCN、DeformableDETR和FSRW相比,3-shot任务下的性能提升分别达到19.5\%、21.9\%和10.1\%。 (3)本文利用LabelImg工具制作路面积水图像数据集及标注文件,采用数据增强的方式扩充基类数据。分别在设计的两个模型中进行路面积水图片的检测。实验表明,自适应元特征加权模型与跨空间注意力蒸馏模型能够有效的识别积水图像中的目标特征。},
	language = {zh},
	school = {中原工学院},
	author = {周鹏},
	year = {2024},
	keywords = {/未读, 路面积水检测, 特征偏移, 小样本学习, 注意力蒸馏, 自适应特征加权},
	file = {基于小样本学习的路面积水检测的研究_周鹏:D\:\\Zotero\\paper\\storage\\GJ46ASZF\\基于小样本学习的路面积水检测的研究_周鹏.pdf:application/pdf},
}

@phdthesis{__2025-13,
	type = {硕士学位论文},
	title = {分焦平面偏振成像系统的非均匀性校正},
	url = {https://doi.org/10.43807/d.cnki.gbtsf.2024.000007},
	doi = {10.43807/d.cnki.gbtsf.2024.000007},
	abstract = {在众多偏振成像系统中,分焦平面偏振成像系统(Division of Focal Plane,Do FP)因其可以实时获取偏振信息的能力而受到重视。然而,分焦平面偏振成像系统固有的非均匀性误差严重影响了偏振图像的质量,限制了其应用范围。本文旨在对非均匀性误差的校正方法进行研究。
尽管先前的研究已在像素响应方面取得了进展,但对偏振信息均匀性的关注不足,且多数研究局限于实验室环境,未能扩展到自然场景。本研究在此基础上,深入分析了非均匀性误差的成因,并考虑到主透射率、次透射率、偏振角和增益、暗偏移这五个关键参量,构建了一个全面的非均匀性误差校正模型。
为评估模型的可靠性,使用标准差(Standard Deviation,SD)作为指标,分析在不同光强、偏振角、波长、曝光时间条件下,校正模型对偏振图像的校正效果。实验结果表明,在多种条件下,校正后图像偏振信息的标准差均低于原始图像的标准差,即该校正模型在不同条件下,均能显著减少偏振图像的非均匀性,使得校正后的偏振信息更加均匀、准确。特别是,自然场景图像在校正后能够更清晰地区分人造物体与自然背景,从而有效提升了分焦平面偏振成像系统的应用价值。此外,实验还揭示了模型的校正效果会随着入射光强度的提高而上升,为进一步优化校正策略提供了重要线索。},
	language = {zh},
