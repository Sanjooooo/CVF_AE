@article{wang_phoenix_2026,
	title = {{PHOENIX}: a hybrid metaheuristic framework for multi-{UAV} collaborative trajectory planning in complex three-dimensional environments},
	volume = {12},
	issn = {2199-4536, 2198-6053},
	shorttitle = {Phoenix},
