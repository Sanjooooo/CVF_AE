	doi = {10.1007/s40747-025-02196-x},
	abstract = {Multi-unmanned aerial vehicle (UAV) collaborative trajectory planning in complex three-dimensional (3D) environments faces critical challenges in real-time coordination, including balancing path optimality, collision avoidance, and computational efﬁciency under dynamic obstacle ﬁelds. While existing metaheuristic algorithms exhibit limitations in convergence speed and adaptability to high-density obstacles ({\textgreater} 0.8thr eats/km3), this study introduces PHOENIX—a hybrid metaheuristic framework that synergizes the crested porcupine optimizer (CPO) and ant lion optimizer (ALO) through a dual-layer cooperative mechanism. Three key innovations are proposed: (1) A hierarchical ﬂight protection zone model compliant with RTCA DO-263 standards, dynamically integrating CPO’s collision-avoidance strategies with real-time risk prediction; (2) A chaos-enhanced initialization strategy employing interval-constrained logistic mapping, which increases population diversity by 32.7\% (quantiﬁed via Shannon entropy, p {\textless} 0.05); (3) An adaptive weight adjustment mechanism with nonlinear decay, achieving 23.5\% and 18.7\% faster convergence than particle swarm optimization (PSO) and grey wolf optimizer (GWO), respectively. Extensive evaluations on LANDSAT 9-derived 3D terrains demonstrate PHOENIX’s superiority: it reduces average path length by 6.2\%, decreases threat exposure by 7.3\%, and improves trajectory smoothness by 8.9\% compared with state-of-the-art benchmarks. AirSim-based simulations with ﬁve UAVs validate 100\% collision-free success rates in dynamic urban scenarios, outperforming CPO and ALO in robustness ( p {\textless} 0.01). The framework effectively resolves explorationexploitation dilemmas while maintaining computational efﬁciency ({\textless} 50ms per planning cycle), offering a scalable solution for mission-critical applications such as disaster response and smart city logistics. By bridging bio-inspired optimization with complex system dynamics, this work advances intelligent autonomous system research.},
	language = {en},
	number = {2},
	urldate = {2026-06-05},
	journal = {Complex \& Intelligent Systems},
	author = {Wang, Ershen and Xu, Haolong and Ji, Guipeng and Yu, Tengli and Xu, Song and Liu, Fei and Li, Fan},
	month = feb,
	year = {2026},
	pages = {72--94},
	file = {Wang 等 - 2026 - PHOENIX a hybrid metaheuristic framework for multi-UAV collaborative trajectory planning in complex.pdf:D\:\\Zotero\\Downloads\\Wang 等 - 2026 - PHOENIX a hybrid metaheuristic framework for multi-UAV collaborative trajectory planning in complex.pdf:application/pdf},
}

@article{liu_policy_2026,
	title = {Policy distillation-based multiagent actor–critic for cooperative {UAV} path planning in complex environments},
	volume = {342},
	issn = {09507051},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0950705126006465},
	doi = {10.1016/j.knosys.2026.115920},
	abstract = {Cooperative path planning for multiple unmanned aerial vehicle systems has become a focal point of research in various domains owing to its inherent advantages in maneuverability, coordination, and robustness. Multiagent reinforcement learning (MARL) demonstrates strong adaptability in complex environments with incomplete or uncertain information, enabling efficient collaboration via autonomous learning. However, MARL often suffers from low sample efficiency, requiring extensive environmental interactions to derive optimal policies. We address this by proposing a personalized policy distillation multiagent actor–critic algorithm that integrates nonexpert policy guidance with personalized distillation techniques to enhance learning efficiency and policy quality. Specifically, we leverage the artificial potential field (APF) method to generate structured, nonexpert policies that are initial guidance framework for agents to effectively reduce the search space and accelerate early-stage learning. Building upon this foundation, we introduce a rule-guided and trainable shared embedding mechanism, instantiated via a conditional variational autoencoder (CVAE), to capture the latent policy representations underlying nonexpert strategies derived from APF. In addition, we design an innovative perturbation network that refines expert actions by exploring superior alternatives, enhancing the exploration capabilities of agents, and policy optimization. Extensive experiments demonstrate that our proposed approach significantly outperforms state-of-the-art methods in terms of success rate, average reward, and average path length.},
	language = {en},
	urldate = {2026-05-14},
	journal = {Knowledge-Based Systems},
	author = {Liu, Huidong and Ai, Jiangshan and Lu, Xu and Long, Xianlei and Li, You and Zhu, Xiangwei and Gu, Fuqiang},
	month = jun,
