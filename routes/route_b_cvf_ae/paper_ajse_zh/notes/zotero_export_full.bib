	pages = {101666},
	file = {PDF:D\:\\Zotero\\paper\\storage\\8PVKSBCP\\Subramaniam 等 - 2026 - Improved energy efficient localization of UAVs in farmlands using hybrid metaheuristic optimization.pdf:application/pdf},
