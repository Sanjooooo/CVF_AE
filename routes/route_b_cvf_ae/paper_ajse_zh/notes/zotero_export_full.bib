@article{__2025-2,
	title = {多策略改进鲸鱼优化算法的无人机路径规划},
	issn = {1671-637X},
	url = {https://link.cnki.net/urlid/41.1227.tn.20250613.1937.002},
	abstract = {针对传统鲸鱼优化算法(WOA)处理无人机三维路径规划任务时，存在收敛性能不足及局部极值敏感度较高的问题，提出一种多策略改进鲸鱼优化算法的无人机路径规划算法。该算法首先借助快速扩展随机树法的全局搜索能力初始化鲸鱼种群，生成覆盖三维可行空间的多模态初始路径，提升种群多样性和算法的全局探索能力；然后将WOA中的线性收敛因子调整为非线性，平衡算法的全局搜索能力与局部开发能力；最后，通过引入自适应权重策略和随机差分变异策略，在加快种群收敛的同时，使算法能够及时跳出局部最优。仿真结果表明，随着场景复杂度的提升，改进算法在三个场景中所规划的最短路径长度相较于标准WOA分别减少了28.886\%，30.486\%，33.061\%。},
	language = {zh},
	journal = {电光与控制},
	author = {{薛阳} and {王馨玥} and {卢秋红} and {倪大斌}},
	month = jun,
	year = {2025},
	note = {Status: advance online publication},
	keywords = {/未读, /unread, 路径规划, 无人机, 鲸鱼优化算法, 快速扩展随机树法, 随机差分变异, 自适应权重},
	pages = {1--10},
	file = {薛阳 等 - 2025 - 多策略改进鲸鱼优化算法的无人机路径规划.pdf:D\:\\Zotero\\paper\\storage\\E3QA9PUD\\薛阳 等 - 2025 - 多策略改进鲸鱼优化算法的无人机路径规划.pdf:application/pdf},
