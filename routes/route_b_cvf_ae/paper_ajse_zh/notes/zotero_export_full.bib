@article{fei_task-driven_2025,
	title = {Task-driven multi-{UAV} path planning via three-stage optimization strategy for urban region surveillance},
	volume = {68},
	issn = {1474-0346, 1873-5320},
	url = {https://www.sciencedirect.com/science/article/pii/S1474034625006640?pes=vor&utm_source=clarivate&getft_integrator=clarivate},
	doi = {10.1016/j.aei.2025.103771},
	abstract = {The application of UAVs for inspection, surveillance, search and rescue, and other objectives has garnered a lot of attention as the low-altitude economy keeps on developing. Path planning, as one of the essential technologies for multi-UAV cooperative execution of target surveillance tasks, has recorded different approaches to this point. However, there are various uncertainties in the complex environment, such as communication network, building occlusion, and equipment stability. The surveillance tasks frequently fail when these uncertain factors are ignored. This research aims to enhance the cooperative surveillance capability of multiple UAVs under local communication networks by planning the reasonable paths for UAVs, which can be modeled as a hybrid linear programming problem. To be specific, the path planning of UAV formation is NP-hard since this model includes various objectives and constraints. Therefore, we develop an approach of task-driven multi-UAV path planning via three-stage optimization strategy (TRUST) in the urban surveillance region, which includes task grouping adaptation, task order optimization, and formation path planning. The proposed TRUST skillfully integrates regional coverage, UAV energy consumption, and task risk to obtain optimal flight paths for UAVs. To demonstrate the superiority of our approach, several experiments are devised to analyze the performance of TRUST. The experimental results demonstrate that TRUST is able to deliver both high urban coverage and low formation flying energy consumption in local communication networks.},
	language = {en},
	urldate = {2026-05-14},
	journal = {Advanced Engineering Informatics},
	publisher = {Elsevier Sci Ltd},
	author = {Fei, Bowen and Liu, Daqian and Bao, Weidong and Zhu, Xiaomin and Li, Xiaoqing},
	month = nov,
	year = {2025},
	note = {numPages: 18
Web of Science ID: WOS:001621725000001
titleTranslation: 通过三阶段优化策略实现的任务驱动多无人机路径规划，用于城市区域监控},
	keywords = {/未读, /unread, Computer Science, Artificial Intelligence, Engineering, Multidisciplinary, Local communication network, Multiple UAVs, Path planning, Regional coverage, SEARCH, Traffic surveillance},
	file = {Fei 等 - 2025 - Task-driven multi-UAV path planning via three-stage optimization strategy for urban region surveilla:D\:\\Zotero\\paper\\storage\\MYKBEUSU\\Fei 等 - 2025 - Task-driven multi-UAV path planning via three-stage optimization strategy for urban region surveilla.pdf:application/pdf;Fei 等 - 2025 - Task-driven multi-UAV path planning via three-stage optimization strategy for urban region surveilla.pdf:D\:\\Zotero\\paper\\storage\\YQT74NMH\\Fei 等 - 2025 - Task-driven multi-UAV path planning via three-stage optimization strategy for urban region surveilla.pdf:application/pdf},
