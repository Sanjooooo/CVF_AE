	doi = {10.1016/j.jlp.2026.105981},
	abstract = {Rapid monitoring of fires and gas leaks in chemical industrial parks was a core challenge for fire safety and emergency management in chemical plants. Traditional manual inspections had low efficiency and high risks. To address the path optimization problem of cooperative inspection by unmanned aerial vehicle (UAV) swarms in the complex environment of chemical industrial parks, an optimization method based on the improved multiobjective jellyfish search algorithm (IMOJSA) was proposed in this paper. Considering the flame recognition system based on YOLO and the chemical gas detection device carried by the UAVs, a multi-objective optimization model including path length, risk level, inspection coverage rate, and data collection quality was constructed. By introducing an adaptive weight mechanism and dynamic neighborhood search strategy, efficient planning of the inspection paths for the UAV swarm was achieved. Experimental results showed that compared with Nondominated Sorting Genetic Algorithm II (NSGA-II) and Multi-Objective Particle Swarm Optimization (MOPSO) algorithms, IMOJSA improved the hypervolume metric (HV) rate index by an average of 10\%, increased the patrol coverage rate by 6\%, reduced the risk exposure time by 20\%, and improved the data collection quality by 5\%. This study provided an innovative intelligent solution for safety inspections in chemical industrial parks.},
	language = {en},
	urldate = {2026-05-14},
	journal = {Journal of Loss Prevention in the Process Industries},
	author = {Wang, Shuang and Fan, Liqiang and Zhang, Mingguang and Jiang, Juncheng and Ni, Lei},
