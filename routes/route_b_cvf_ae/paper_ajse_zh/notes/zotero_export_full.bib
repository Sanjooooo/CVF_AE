	author = {Xiong, Yangyilei and Tian, Haoyu and Tang, Jianing and Jin, Jie and Shen, Xiaoning},
	month = nov,
	year = {2025},
	note = {numPages: 25
Web of Science ID: WOS:001624577700001},
	keywords = {/unread, Remote Sensing, ALGORITHM, ALLOCATION, K-Means plus plus genetic algorithm, MNIDP, MTSPN, TRAVELING SALESMAN PROBLEM, UAV inspection},
}

