@phdthesis{__2022-3,
	address = {西安},
	type = {硕士学位论文},
	title = {基于深度学习的城市积涝边界与水位智慧测量方法研究},
	url = {https://doi.org/10.27398/d.cnki.gxalu.2021.000319},
	doi = {10.27398/d.cnki.gxalu.2021.000319},
	abstract = {随着全球气候变化愈加剧烈,极端降雨频次不断增多,与此同时城镇化进程快速发展,极大地改变了下垫面条件,使得城市内涝积水问题日益突出。安全、高效及精准地开展城市内涝积水监测对降低内涝成灾风险、减少内涝引起的城市交通及市民安全等隐患具有重要意义。本论文针对目前城市区域内涝频发且人工现场监测等传统内涝积水监测方法具有危险性大、成本较高及时效性较低等问题,提出了一种利用深度学习技术的城市积涝边界与水位智慧测量方法。一方面,本文基于深度学习技术初步实现对城市积水自动识别并获取面积。利用角度变换、彩色转换方法对图像数据集进行扩充,分别采用YOLOv2和Mask R-CNN预训练模型构建积水图像识别模型,实现对图像中的积水进行识别及提取面积,并分别于实测积水面积进行对比。结果表明,由于积水面积的不规则性,相比YOLOv2目标检测算法,Mask R-CNN算法获取积水面积的效果更佳,在该次实验中识别计算得到的积水面积与实测面积的平均误差仅约为5.16\%。将深度学习技术应用到积水图像中积水面积信息提取具有一定的可行性及研究价值,且Mask R-CNN算法框架对图像中积水区域具有很好的分割效果,更适合对积水边界和面积的自动提取和测量。另一方面,一种基于深度学习的目标检测算法——SSD被应用到水位监测识别中。通过安装简易水尺及摄像设备获取大量图像数据集,基于原始的SSD预训练模型训练得到水尺目标检测模型,识别提取位于水面以上的水尺像素,采用摄影测量原理可实现对水位的自动获取。为验证方法的准确性,不仅分别对白天和夜间的水位进行了模拟分析,且进一步通过持续监测24h的水位变化过程,并与实测数据进行了对比验证。在显示结果中,计算值与测量值之间的误差范围为-5.35\%至+16.41\%。此外,通过计算R2和NSE均大于0.99,这表明该方法具有较高的准确性,可以为测量管理部门在这一领域提供一种相对准确和可靠的技术。通过以上研究结果表明,深度学习技术可以初步且成功地被应用到城市积涝边界与水位的智能监测中,且与传统的人工监测方法相比,安全性高,效率高且成本较低。因此,该研究可为城市内涝实时监测及逃生路线的优化提供有效的技术支撑和重要的参考价值。},
	language = {zh},
	urldate = {2025-05-02},
	school = {西安理工大学},
	author = {{白岗岗}},
	collaborator = {{侯精明}},
	year = {2022},
	note = {major: 水力学及河流动力学
foundation: 国家重点研发计划(编号:2016YFC0402704)； 国家千人计划； 陕西省创新能力支撑计划(编号:2020TD-023)； 国家自然科学基金(编号:52079106)； 国家自然科学基金(编号:52009104)；
