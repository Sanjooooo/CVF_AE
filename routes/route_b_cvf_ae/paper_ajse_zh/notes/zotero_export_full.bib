@article{gong_bi-level_2026-1,
	title = {Bi-level optimization for multi-{UAV} collaborative coverage path planning in irregular areas},
	volume = {14},
	issn = {2227-7390},
	url = {https://www.mdpi.com/2227-7390/14/3/416},
	doi = {10.3390/math14030416},
	abstract = {Multiple Unmanned Aerial Vehicle (UAV) collaborative coverage path planning is widely applied in fields such as regional surveillance. However, optimizing the trade-off between deployment costs and task execution efficiency remains challenging. To balance resource costs and execution efficiency with an uncertain number of UAVs, this paper analyzes the characteristics of irregular mission areas and formulates a bi-level optimization model for multi-UAV collaborative CPP. The model aims to minimize both the number of UAVs and the total path length. First, in the upper level, an improved Best Fit Decreasing algorithm based on binary search is designed. Straight-line scanning paths are generated by determining the minimum span direction of the irregular regions. Task allocation follows a longest-path-first, minimum-residual-range rule to rapidly determine the minimum number of UAVs required for complete coverage. Considering UAV’s turning radius constraints, Dubins curves are employed to plan transition paths between scanning regions, ensuring path feasibility. Second, the lower level transforms the problem into a Multiple Traveling Salesman Problem that considers path continuity, range constraints, and nonoverlapping path allocation. This problem is solved using an Improved Biased Random Key Genetic Algorithm. The algorithm employs a variable-length master–slave chromosome encoding structure to adapt to the task allocation of each UAV. By integrating biased crossover operators with 2-opt interval mutation operators, the algorithm accelerates convergence and improves solution quality. Finally, comparative experiments on mission regions of varying scales demonstrate that, compared with single-level optimization and other intelligent algorithms, the proposed method reduces the required number of UAVs and shortens the total path length, while ensuring complete coverage of irregular regions. This method provides an efficient and practical solution for multi-UAV collaborative CPP in complex environments.},
	language = {en},
	number = {3},
	urldate = {2026-05-26},
	journal = {Mathematics},
	author = {Gong, Hua and Fu, Ziyang and Xu, Ke and Sun, Wenjuan and Xu, Wanning and Du, Mingming},
	month = jan,
	year = {2026},
	note = {titleTranslation: 不规则区域多无人机协同覆盖路径规划的双层优化。},
	keywords = {/unread},
	pages = {416--448},
	file = {PDF:D\:\\Zotero\\paper\\storage\\62F2LP7G\\Gong 等 - 2026 - Bi-level optimization for multi-UAV collaborative coverage path planning in irregular areas.pdf:application/pdf},
}

@article{vijayan_cahmo_2026-1,
	title = {{CAHMO}: {Cylindrical} adaptive human memory optimization for cooperative multi-{UAV} {3D} path planning},
	volume = {59},
	issn = {22142096},
	shorttitle = {Cahmo},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2214209626000203},
	doi = {10.1016/j.vehcom.2026.101018},
	abstract = {Multiple unmanned aerial vehicles (multi-UAVs) require coordinated trajectory planning for mission-critical applications such as surveillance, disaster relief, and precision agriculture. The requirement for simultaneous obstacle avoidance, geometrically smooth ﬂight dynamics, and inter-UAV cooperation makes this challenge extremely complicated. This study proposes Adaptive Human Memory Optimization (AHMO) with Cylindrical Encoding (CAHMO), a novel planner designed to address these problems. In place of conventional Cartesian-based representations, cylindrical coordinates are utilized to minimize search redundancy and organically integrate UAV motion features. The enhanced Human Memory Optimization (HMO) framework incorporates adaptive learning methods that strengthen exploration-exploitation balance and increase solution stability in cluttered 3D spaces. The proposed method is validated through simulations on elevation-based terrain models, incorporating multiple cylindrical hazard regions that represent restricted or unsafe areas for UAV ﬂight. The results show that CAHMO preserves computational eﬃciency while achieving faster convergence, smoother trajectories, and more reliable obstacle avoidance compared to existing metaheuristics, such as HMO, Particle Swarm Optimization (PSO), Interactive Cylinder Vector Teaching-Learning-Based Optimization (ICVTLBO), and Cylindrical Vector PSO with Gene Targeting (GTCPSO). These outcomes demonstrate CAHMO’s eﬃcacy as a strong optimization framework for cooperative path planning among multiple UAVs under realistic constraints.},
	language = {en},
	urldate = {2026-05-26},
	journal = {Vehicular Communications},
	author = {Vijayan, Dilna and Mostafa, Reham R. and Khedr, Ahmed M.},
	month = jun,
	year = {2026},
	note = {titleTranslation: CAHMO：协同多无人机三维航迹规划的圆柱形自适应人类记忆优化。},
	keywords = {/unread},
	pages = {101018},
	file = {PDF:D\:\\Zotero\\paper\\storage\\I7Z5Q6E2\\Vijayan 等 - 2026 - CAHMO cylindrical adaptive human memory optimization for cooperative multi-UAV 3D path planning.pdf:application/pdf},
}

