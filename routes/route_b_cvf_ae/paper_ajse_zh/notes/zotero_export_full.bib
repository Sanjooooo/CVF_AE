	author = {Gao, Qian and Jin, Anru and Wang, Chuanyun and Zhang, Lei and Zhang, Qingxin and Xiong, Xuhai and Yang, Fengtian},
	month = nov,
	year = {2025},
	note = {titleTranslation: AEGWCPO：一种用于复杂山区环境中无人机群渗透的协作路径规划方法},
	keywords = {/未读, /unread},
	pages = {116301},
	file = {Gao 等 - 2025 - AEGWCPO a cooperative path planning method for UAV swarm penetration in complex mountainous environ.pdf:D\:\\Zotero\\paper\\storage\\YMXYPXX2\\Gao 等 - 2025 - AEGWCPO a cooperative path planning method for UAV swarm penetration in complex mountainous environ.pdf:application/pdf},
