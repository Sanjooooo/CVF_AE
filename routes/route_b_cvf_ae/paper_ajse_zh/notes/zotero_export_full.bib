Web of Science ID: WOS:001452237500001},
	keywords = {/unread, Remote Sensing, path planning, DIFFERENTIAL EVOLUTION, GLOBAL OPTIMIZATION, meta-heuristic algorithm, multiple unmanned aerial vehicles, slime mold algorithm, STRATEGY},
}

