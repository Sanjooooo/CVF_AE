	doi = {10.1016/j.aei.2025.103999},
	abstract = {As the real situation becomes more and more complex, it is necessary to satisfy the demand for complex tasks by multiple unmanned aerial vehicles (UAVs). Aiming at the complex situation that multiple UAVs need to reach multiple mission points simultaneously, this paper constructs a smooth path planning model (PPM) with two objective functions for multiple UAVs with multiple mission points based on minimizing the total path length and minimizing the path curvature. The model enables UAVs to arrive at the mission points at the same time by restricting their flight trajectories and speeds, and the paths are required to satisfy G0 continuity and G1 continuity at the mission points. For this model, a sub-optimal solutions-based hybrid multi-objective differential evolutionary algorithm (SHMODE) is proposed. SHMODE consists of three new mutation mechanisms based on sub-optimal solutions. The three variation mechanisms can effectively enhance the convergence and diversity of the algorithm. And the individual non-dominated memory strategy provides more diverse options for updating individual positions. In addition, SHMODE incorporates the adaptive mutation factor strategy and the WeiBull exploration operator strategy. The WeiBull exploration operator boosts the exploration capacity of individuals. To verify the efficiency of SHMODE, it is compared with several excellent multi-objective algorithms on the classical test set DTLZ. The data show that SHMODE has a clear advantage. Finally, SHMODE is applied to the complex optimization model being built. In different environments, SHMODE always achieves relative optimality in several of the proposed performance metrics. Its resulting flight paths are also relatively the safest, smoothest, and most coordinated.},
	language = {en},
	urldate = {2026-05-26},
	journal = {Advanced Engineering Informatics},
