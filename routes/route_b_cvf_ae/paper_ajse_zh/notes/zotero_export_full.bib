@article{luo_multi-strategy_2025,
	title = {A multi-strategy improved coati optimization algorithm for solving global optimization problems},
	volume = {28},
	issn = {1573-7543},
	url = {https://doi.org/10.1007/s10586-024-04713-y},
	doi = {10.1007/s10586-024-04713-y},
	abstract = {Meta-heuristic algorithms have garnered significant attention from researchers due to their broad applicability in addressing complex optimization problems. The Coati Optimization Algorithm (COA) is a swarm intelligence technique characterized by its simple structure and effectiveness. In fact, COA has great room for improvement in terms of balancing exploration and exploitation, falling into local optimization, iteration accuracy, etc. To address these limitations and enhance COA's robustness, we propose a multi-strategy improved Coati Optimization Algorithm (MICOA). Firstly, the algorithm's structure is refined, and a novel exploration strategy is introduced to accelerate convergence in the early stages. Secondly, during the exploitation phase, Levy flights and Brownian motion strategies are incorporated to preserve population diversity and improve the algorithm's ability to escape local optima, thereby enhancing convergence accuracy. Finally, MICOA's performance is evaluated through tests on various dimensions of the CEC2017 and CEC2022 benchmark functions, and compared with other optimization algorithms. Experimental results demonstrate that MICOA outperforms other algorithms in overall performance. The successful application of MICOA to ten mechanical engineering optimization problems, Unmanned Aerial Vehicle (UAV) path planning, and COVID-19 case prediction further validates its feasibility and scalability for practical problem-solving.},
	language = {en},
	number = {4},
	urldate = {2025-12-09},
	journal = {Cluster Computing},
	author = {Luo, Xin and Yuan, Yage and Fu, Youfa and Huang, Haisong and Wei, Jianan},
	month = feb,
	year = {2025},
	note = {titleTranslation: 一种多策略改进的coati优化算法用于解决全局优化问题},
	keywords = {/未读, /unread, Engineering optimization, Improved coati optimization, Meta-heuristic algorithm, Path planning of UAV},
	pages = {264},
	file = {Luo 等 - 2025 - A multi-strategy improved coati optimization algorithm for solving global optimization problems.pdf:D\:\\Zotero\\paper\\storage\\EZMB4T33\\Luo 等 - 2025 - A multi-strategy improved coati optimization algorithm for solving global optimization problems.pdf:application/pdf},
