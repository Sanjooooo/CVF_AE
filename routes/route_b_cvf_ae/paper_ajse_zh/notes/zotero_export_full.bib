@article{chen_multi-uav_2025,
	title = {Multi-{UAV} path planning problem with biased sampling, candidate evaluation, and path reconfiguration in complex environment with threats},
	volume = {291},
	issn = {09574174},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0957417425021773},
	doi = {10.1016/j.eswa.2025.128558},
	abstract = {The application of multiple Unmanned Aerial Vehicles (UAVs) in complex urban environments has demonstrated significant potential for emergency response, infrastructure inspection, and urban environmental monitoring. However, path planning for multi-UAV systems in such environments remains particularly challenging due to the presence of various threat zones, including obstacles, signal interference regions, and hazardous areas, which existing methods fail to address adequately. We present an enhanced grid-based modeling approach specifically designed for urban environments with distinct threat zones to bridge this gap. In addition, we propose an improved Multi-UAV Rapidly-exploring Random Tree Star (RRT*) algorithm integrated with Biased Sampling, Candidate Evaluation and Path Reconfiguration techniques (MU-RRT*-BCR). Specifically, the combination of biased sampling and candidate evaluation enhances node selection, reducing the average objective function value by 16.66\% and CPU time by 80.28\% compared to MU-RRT*. Additionally, a security detection mechanism is incorporated to prevent inter-UAV collisions. Moreover, a path reconfiguration technique is employed to refine the UAV trajectories, while the Dubins method is applied to ensure that the planned paths satisfy UAV kinematic constraints. Overall, extensive comparative studies validate our algorithm against several RRT* variants and A* algorithms. Compared to MU-RRT*, the proposed method reduces the average objective function value by 17.59\% and CPU time by 81.26\% while achieving 4.86\% and 65.91\% reductions, respectively, compared to A*. Furthermore, A practical case study based on Changsha’s skyline illustrates the method’s robustness and analyzes key factors impacting planning.},
	language = {en},
	urldate = {2026-05-14},
