	file = {韩平丽 - 2018 - 水下目标偏振成像探测技术研究.pdf:D\:\\Zotero\\paper\\storage\\E2BM8I9U\\韩平丽 - 2018 - 水下目标偏振成像探测技术研究.pdf:application/pdf},
}

