	note = {titleTranslation: 多无人机协同覆盖路径规划的双层优化},
	keywords = {/未读, /unread},
	pages = {416--448},
	file = {PDF:D\:\\Zotero\\paper\\storage\\K9KWVAZ2\\Gong 等 - 2026 - Bi-level optimization for multi-UAV collaborative coverage path planning in irregular areas.pdf:application/pdf},
