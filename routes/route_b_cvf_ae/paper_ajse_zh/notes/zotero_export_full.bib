@article{__2026-2,
	title = {基于双层强化学习的异构多无人机任务规划},
	url = {https://kns.cnki.net/KCMS/detail/detail.aspx?dbcode=CAPJ&dbname=CAPJLAST&filename=JSJA20260427002},
	abstract = {随着现代作战场景日益复杂化，多种类无人机协同作战已经成为提高作战效能的重要手段。面向异构多无人机系统在复杂战场环境中的任务规划问题，强化学习算法虽能通过与环境交互自主学习决策策略，但存在实时性较差、模型求解计算复杂度高的问题。为降低异构多无人机任务分配与路径规划的联合优化模型求解的复杂度，提出基于双层强化学习架构的BiARL（Bi-level Attention Reinforcement Learning， BiARL）算法：上层基于近端策略优化（Proximal Policy Optimization， PPO）算法，引入图注意力与动作掩码机制，根据任务和无人机类型进行任务分配，确保每个任务都被分配给具备相应执行能力的无人机；下层采用基于注意力机制的A2C模型，为每个无人机生成具体的任务执行路径，在满足航程约束的同时最大化任务完成价值。实验在包含80个任务点与3类无人机的场景中进行，结果表明：所提方法在测试场景中平均任务完成价值为37.607，平均航程利用率为91.35\%，单次计算时间仅0.044秒，在所有算法中实时性表现最好，且在平均任务完成价值与航程利用率上优于K-means+VND、K-means+AM等启发式算法。该研究为异构无人机集群的实时协同决策提供了有效途径。},
	language = {zh},
	urldate = {2026-06-05},
	journal = {计算机科学},
	author = {{付星桐} and {吴亚辉} and {马武彬} and {周浩浩} and {戴超凡}},
	month = apr,
	year = {2026},
	note = {Status: advance online publication
dbcode: CAPJ
dbname: CAPJLAST
filename: JSJA20260427002
Fund: 国家自然科学基金面上项目（61871388）；},
	keywords = {路径规划, 任务分配, 分层决策, 强化学习, 异构无人机},
	pages = {1--13},
	file = {基于双层强化学习的异构多无人机任务规划_付星桐.pdf:D\:\\Zotero\\Downloads\\基于双层强化学习的异构多无人机任务规划_付星桐.pdf:application/pdf},
}

@article{__2025-17,
	title = {基于自适应多策略改进蛇优化算法的多无人机路径规划方法},
	url = {https://kns.cnki.net/KCMS/detail/detail.aspx?dbcode=CAPJ&dbname=CAPJLAST&filename=DGKQ20251029002},
	abstract = {在动态复杂战场环境中，为多无人机规划精确、高效的路径能显著提升无人机整体作战效能。针对战场环境中多无人机路径规划中存在的多目标、多约束等问题，提出了一种自适应多策略改进蛇优化(AMISO)算法。在传统蛇优化算法上，引入多策略混沌系统增强个体初始分布的随机性与均匀性；探索阶段融合冰霜优化策略，拓展搜索范围，提高算法收敛速度；战斗阶段引入轮盘自适应迭代策略，提高算法鲁棒性；交配阶段引入种群层叠进化机制，即保证了种群多样性，也平衡了全局开发能力。利用标准测试函数和在两种不同地形环境中对AMISO算法进行测试分析，结果表明：AMISO算法的寻优能力和收敛速度较其它启发式算法有较大提升，能为每架无人机规划出满足性能约束且最优路径。},
	language = {zh},
	urldate = {2026-06-05},
	journal = {电光与控制},
	author = {{王凯} and {郭玉英} and {廖兰馨}},
