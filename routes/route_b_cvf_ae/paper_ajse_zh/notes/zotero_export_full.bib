@article{aljalaud_optimizing_2025,
	title = {Optimizing {Autonomous} {Multi}-{UAV} {Path} {Planning} for {Inspection} {Missions}: {A} {Comparative} {Study} of {Genetic} and {Stochastic} {Hill} {Climbing} {Algorithms}},
	volume = {18},
	issn = {1996-1073},
	shorttitle = {Optimizing {Autonomous} {Multi}-{UAV} {Path} {Planning} for {Inspection} {Missions}},
	doi = {10.3390/en18010050},
	abstract = {Efficient path planning is vital for multi-UAV inspection missions, yet the comparative effectiveness of different optimization strategies has not received much attention. This paper introduces the first application of the Genetic Algorithm (GA) and Hill Climbing (HC) to multi-UAV inspection of indoor pipelines, providing a unique comparative analysis. GA exemplifies the global search strategy, while HC illustrates an enhanced stochastic local search. This comparison is impactful as it highlights the trade-offs between exploration and exploitation-two key challenges in multi-UAV path optimization. It also addresses practical concerns such as workload balancing and energy efficiency, which are crucial for the successful implementation of UAV missions. To tackle common challenges in multi-UAV operations, we have developed a novel repair mechanism. This mechanism utilizes problem-specific repair heuristics to ensure feasible and valid solutions by resolving redundant or missed inspection points. Additionally, we have introduced a penalty-based approach in HC to balance UAV workloads. Using the Crazyswarm simulation platform, we evaluated GA and HC across key performance metrics: energy consumption, travel distance, running time, and maximum tour length. The results demonstrate that GA achieves a 22\% reduction in travel distance and a 23\% reduction in energy consumption compared to HC, which often converges to suboptimal solutions. Additionally, GA outperforms HC, Greedy, and Random strategies, delivering at least a 13\% improvement in workload balancing and other metrics. These findings establish a novel and impactful benchmark for comparing global and local optimization strategies in multi-UAV tasks, offering researchers and practitioners critical insights for selecting efficient and sustainable approaches to UAV operations in complex inspection environments.},
	language = {en},
	number = {1},
	urldate = {2026-05-13},
	journal = {Energies},
	publisher = {MDPI},
	author = {Aljalaud, Faten and Alohali, Yousef},
	month = jan,
	year = {2025},
	note = {numPages: 22
Web of Science ID: WOS:001393597100001},
	keywords = {/unread, path planning, multi-UAV, genetic algorithm, autonomous, Energy \& Fuels, inspection},
}

@article{wang_hcrs_2026-1,
	title = {{HCRS}: {Hierarchical} cooperative recombination strategy for many-objective multi-{UAV} path planning},
	volume = {217},
	issn = {0965-9978, 1873-5339},
	shorttitle = {{HCRS}},
	doi = {10.1016/j.advengsoft.2026.104160},
	abstract = {As the decision-making core of UAV to perform complex tasks, path planning aims to generate a safe, efficient and feasible flight path for the aircraft, which directly determines the success rate of the task and the energy efficiency ratio of the system. However, the multi-UAV path planning problem is a typical high-dimensional strong-coupled multi-objective optimization problem, and it is a great challenge to achieve both individual flight efficiency and group cooperative performance under complex space and time constraints. Therefore, this paper proposes a Hierarchical Cooperative Recombination Strategy (HCRS) for multi-UAV cooperative path optimization. The framework decomposes the global problem through a "two-level optimization" structure: in the lower level, each UAV performs multi-objective optimization independently to generate a candidate solution set, and then matches and fuses the candidate paths based on the collaborative recombination mechanism of non-dominated solutions, so as to construct a feasible and consistent multi-UAV path plan. In the upper layer, an evolutionary external archive mechanism is designed to maintain the diversity of non-dominated solutions and establish an information feedback channel between the upper and lower layers, so that the algorithm can continue to expand the search space while maintaining convergence stability, and realize the organic unification of global and local optimization. In order to improve the search efficiency and adaptability of the system, HCRS introduces adaptive operator switching hybrid algorithm (AHS-GGWO), which realizes the adaptive adjustment of global exploration and local exploitation through the dynamic balance between grey Wolf optimization operator and genetic operator. Through the synergy of the above mechanisms, HCRS forms a dynamic evolution process of "individual optimization - global cooperation - information feedback", which effectively takes into account the quality of solution set and computational scalability. In the experimental verification of multi-UAV scenarios, HCRS shows higher optimization efficiency, convergence stability and robustness. The results show that the proposed HCRS framework can realize the efficient cooperation of multiple UAV systems in complex mission environments, and provides a scalable and practical optimization idea for the high-dimensional multi-objective path planning problem.},
	language = {en},
	urldate = {2026-05-13},
	journal = {Advances in Engineering Software},
	publisher = {Elsevier Sci Ltd},
	author = {Wang, Zhendong and Wang, Jie and Xie, Huamao and Li, Dahai},
	month = jun,
	year = {2026},
	note = {numPages: 28
Web of Science ID: WOS:001720210100001},
	keywords = {/unread, Computer Science, Interdisciplinary Applications, Engineering, Multidisciplinary, ALGORITHM, Adaptive hybrid switching, Computer Science, Software Engineering, Evolutionary external archive, GREY WOLF OPTIMIZER, Hierarchical cooperative recombination, Many-objective optimization, Multi-UAV path planning, strategy},
}

@article{rao_multi-uav_2025,
	title = {Multi-{UAV} trajectory planning with field-of-view sharing mechanism in cluttered environments: application to target tracking},
	volume = {68},
	issn = {1674-733X, 1869-1919},
	shorttitle = {Multi-{UAV} trajectory planning with field-of-view sharing mechanism in cluttered environments},
	doi = {10.1007/s11432-024-4394-6},
	abstract = {Multi-unmanned aerial vehicle (multi-UAV) target tracking requires coordinated trajectory planning that simultaneously ensures formation safety, target visibility, and motion smoothness. To address this challenge, we propose a distributed framework integrating heuristic-guided path search with spatiotemporal trajectory optimization. In the front end, each UAV constructs a safe area that accounts for both tracking distance and visibility considerations, and selects feasible expansion points for path search based on the desired tracking position. Subsequently, a unified trajectory optimizer is employed to derive an executable trajectory that complies with extensive constraints, predicated on the initial path configurations. Considering that UAVs may lose visibility of the target due to cluttered obstacles, a field-of-view sharing mechanism is proposed, enabling occluded UAVs to leverage teammates' visual data for robust collaborative planning in cluttered environments. Finally, simulations and comparative results are conducted through a visualization platform to validate the superior performance of the proposed multi-UAV trajectory planning framework for target tracking.},
	language = {en},
	number = {5},
	urldate = {2026-05-13},
	journal = {Science China-Information Sciences},
