	keywords = {/unread, Remote Sensing, multi-UAV, 3D path planning, conflict resolution, incremental update, jump point search algorithm},
}

@article{pu_levenberg-marquardt-based_2026-1,
	title = {A {Levenberg}-{Marquardt}-based optimization algorithm for multi-{UAV} path planning in complex media},
	volume = {156},
