	shorttitle = {{VF}-{RRT}*-{PSO}},
	doi = {10.1109/MILCOM64451.2025.11309966},
	abstract = {We present VF-RRT*-PSO, a fully decentralized framework for Multi-UAV Cooperative Path Planning (MUCPP) in partially known, obstacle-dense environments. The system integrates (i) vector field-guided RRT* for fast, goal-oriented global path initialization, (ii) particle swarm optimization (PSO) with adaptive topology switching for multi-objective trajectory refinement, and (iii) a lightweight leader-follower coordination scheme for scalable conflict resolution. Consistent vector field guidance in both planning and refinement preserves path quality and enhances obstacle avoidance in cluttered environments. Across diverse benchmark scenarios, VF-RRT*-PSO reduces collisions, shortens path lengths, and maintains sub-quadratic runtime growth for large UAV teams, outperforming established baselines in safety, efficiency, and scalability.},
