	abstract = {Cooperative path planning for multiple unmanned aerial vehicle systems has become a focal point of research in various domains owing to its inherent advantages in maneuverability, coordination, and robustness. Multiagent reinforcement learning (MARL) demonstrates strong adaptability in complex environments with incomplete or uncertain information, enabling efficient collaboration via autonomous learning. However, MARL often suffers from low sample efficiency, requiring extensive environmental interactions to derive optimal policies. We address this by proposing a personalized policy distillation multiagent actor–critic algorithm that integrates nonexpert policy guidance with personalized distillation techniques to enhance learning efficiency and policy quality. Specifically, we leverage the artificial potential field (APF) method to generate structured, nonexpert policies that are initial guidance framework for agents to effectively reduce the search space and accelerate early-stage learning. Building upon this foundation, we introduce a rule-guided and trainable shared embedding mechanism, instantiated via a conditional variational autoencoder (CVAE), to capture the latent policy representations underlying nonexpert strategies derived from APF. In addition, we design an innovative perturbation network that refines expert actions by exploring superior alternatives, enhancing the exploration capabilities of agents, and policy optimization. Extensive experiments demonstrate that our proposed approach significantly outperforms state-of-the-art methods in terms of success rate, average reward, and average path length.},
	language = {en},
	urldate = {2026-05-26},
	journal = {Knowledge-Based Systems},
	author = {Liu, Huidong and Ai, Jiangshan and Lu, Xu and Long, Xianlei and Li, You and Zhu, Xiangwei and Gu, Fuqiang},
	month = jun,
	year = {2026},
	note = {titleTranslation: 基于策略蒸馏的多智能体执行器-评论家用于复杂环境下的协作无人机路径规划。},
	keywords = {/unread},
	pages = {115920},
	file = {PDF:D\:\\Zotero\\paper\\storage\\HZGKCL9N\\Liu 等 - 2026 - Policy distillation-based multiagent actor–critic for cooperative UAV path planning in complex envir.pdf:application/pdf},
}

@article{wang_research_2026-1,
	title = {Research on multi-objective optimization method for cooperative inspection path of {UAV} swarm in chemical industrial parks},
	volume = {102},
	issn = {09504230},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0950423026000707},
	doi = {10.1016/j.jlp.2026.105981},
	abstract = {Rapid monitoring of fires and gas leaks in chemical industrial parks was a core challenge for fire safety and emergency management in chemical plants. Traditional manual inspections had low efficiency and high risks. To address the path optimization problem of cooperative inspection by unmanned aerial vehicle (UAV) swarms in the complex environment of chemical industrial parks, an optimization method based on the improved multiobjective jellyfish search algorithm (IMOJSA) was proposed in this paper. Considering the flame recognition system based on YOLO and the chemical gas detection device carried by the UAVs, a multi-objective optimization model including path length, risk level, inspection coverage rate, and data collection quality was constructed. By introducing an adaptive weight mechanism and dynamic neighborhood search strategy, efficient planning of the inspection paths for the UAV swarm was achieved. Experimental results showed that compared with Nondominated Sorting Genetic Algorithm II (NSGA-II) and Multi-Objective Particle Swarm Optimization (MOPSO) algorithms, IMOJSA improved the hypervolume metric (HV) rate index by an average of 10\%, increased the patrol coverage rate by 6\%, reduced the risk exposure time by 20\%, and improved the data collection quality by 5\%. This study provided an innovative intelligent solution for safety inspections in chemical industrial parks.},
	language = {en},
	urldate = {2026-05-26},
	journal = {Journal of Loss Prevention in the Process Industries},
	author = {Wang, Shuang and Fan, Liqiang and Zhang, Mingguang and Jiang, Juncheng and Ni, Lei},
	month = aug,
	year = {2026},
	note = {titleTranslation: 化工园区无人机集群协同巡检路径多目标优化方法研究。},
	keywords = {/unread},
	pages = {105981},
	file = {PDF:D\:\\Zotero\\paper\\storage\\IFZFF2D9\\Wang 等 - 2026 - Research on multi-objective optimization method for cooperative inspection path of UAV swarm in chem.pdf:application/pdf},
}

@article{han_time-window-constrained_2026-1,
	title = {Time-window-constrained computation offloading via cost-efficient multi-{UAV} scheduling in space-air-ground integrated networks},
	volume = {75},
	issn = {18744907},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1874490726000510},
	doi = {10.1016/j.phycom.2026.103042},
	abstract = {In air-ground collaborative sensing scenarios such as periodic environmental monitoring, emergency rescue, and military reconnaissance in remote areas, computation tasks are often subject to strict time window constraints, urgently necessitating eﬃcient computing mechanisms to guarantee their timeliness. We investigate the joint optimization problem of computation oﬄoading and unmanned aerial vehicle (UAV) scheduling under timewindow constraints within a collaborative computing architecture involving UAVs and high-altitude platform (HAP). To reduce the number of dispatched UAVs and their energy consumption, a mixed-integer nonlinear programming problem is formulated aiming at minimizing the execution cost of computation tasks. Addressing the core challenge posed by the non-convex strong coupling between discrete and continuous variables, we propose a novel bi-level collaborative optimization strategy (BCOS). The outer layer employs the covariance matrix adaptation evolution strategy (CMA-ES) to eﬃciently search for optimal task oﬄoading ratios within the continuous domain, while the inner layer, given the oﬄoading strategy, precisely solves the discrete UAV route planning subproblem based on the branch-and-price algorithm. Through the iterative interaction between the inner and outer layer algorithms, the joint optimization of discrete and continuous variables is achieved upon convergence. Simulation results demonstrate that BCOS can eﬀectively coordinate the optimization of computational resources and UAVs scheduling strategies, signiﬁcantly reducing the number of dispatched UAVs and energy consumption, thereby validating its eﬀectiveness and superiority in complex task execution scenarios.},
	language = {en},
	urldate = {2026-05-26},
	journal = {Physical Communication},
	author = {Han, Zhe and Zheng, Guoqiang and Li, Chuanfeng and Ji, Baofeng},
	month = mar,
	year = {2026},
	note = {titleTranslation: 在空天地一体化网络中，通过成本有效的多无人机调度实现时间窗口受限的计算卸载。},
	keywords = {/unread},
	pages = {103042},
	file = {PDF:D\:\\Zotero\\paper\\storage\\K56FW8FV\\Han 等 - 2026 - Time-window-constrained computation offloading via cost-efficient multi-UAV scheduling in space-air-.pdf:application/pdf},
}

@article{duan_two-layer_2026-1,
	title = {Two-layer collaborative optimization for task allocation and path planning of multi-{UAVs} with application to island monitoring},
	volume = {358},
	issn = {00298018},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0029801826013818},
	doi = {10.1016/j.oceaneng.2026.125547},
	abstract = {This research presents a two-layer optimization framework for collaborative task allocation and path planning of unmanned aerial vehicles (UAVs) to address the challenges of environmental monitoring on complex island terrains. First, a high-precision 3D terrain model is created by combining cubic Bézier curves with Gaussian filtering, providing a realistic environment for algorithm evaluation. Second, the upper layer employs the improved ant colony optimization–discrete artificial lemming algorithm (IACO-DALA) framework to achieve comprehensive coverage task allocation using the minimal number of UAVs, constrained by their maximum ranges. Finally, the lower layer develops a multi-strategy enhanced artificial lemming algorithm (MSEALA) for path planning by integrating gray wolf optimization (GWO) with the artificial lemming algorithm (ALA). This approach combines chaotic mapping initialization, golden ratio local search, and B-spline smoothing techniques to optimize multi-objective paths. Experiments demonstrate that on the traveling salesman problem (TSP) test sets (eli76, rand300) and in custom island scenarios, the IACO-DALA framework requires an average of 6.2 and 9.6 UAVs, respectively, compared to 8–30 UAVs for the baseline algorithm, while achieving complete task coverage. The MSEALA algorithm shows a 29.93\% improvement in overall path planning efficiency and an 18.06\% reduction in computation time, significantly outperforming algorithms such as ALA and the hybrid chaos game and gray wolf optimization (HCGO). This framework offers an effective solution for real-time island environmental monitoring and provides significant engineering value for island ecological protection and environmental governance in the marine engineering field.},
	language = {en},
	urldate = {2026-05-26},
	journal = {Ocean Engineering},
	author = {Duan, Zhaoxia and Song, Guicai and Liu, Tao and Xiang, Zhengrong},
	month = jun,
	year = {2026},
	note = {titleTranslation: 应用于海岛监测的多无人机任务分配与路径规划双层协同优化。},
	keywords = {/unread},
	pages = {125547},
	file = {PDF:D\:\\Zotero\\paper\\storage\\9VU52XRC\\Duan 等 - 2026 - Two-layer collaborative optimization for task allocation and path planning of multi-UAVs with applic.pdf:application/pdf},
}

