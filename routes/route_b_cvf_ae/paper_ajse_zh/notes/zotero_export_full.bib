	author = {Rao, Kai and Yan, Huaicheng and Yang, Penghui and Wang, Meng and Lv, Yunkai},
	month = may,
	year = {2025},
	note = {numPages: 14
Web of Science ID: WOS:001479679700001},
	keywords = {/unread, Engineering, Electrical \& Electronic, multi-UAV, Computer Science, Information Systems, field-of-view sharing mechanism, target tracking, trajectory planning},
}

